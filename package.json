{
  "name": "mcp-human-approval-gate",
  "version": "0.1.0",
  "description": "An AI agent prepares an action, only a human approves the exact preview, then the agent runs it once. Tiny MCP server, Agent Skill and reusable gate.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel221287",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daniel221287/mcp-human-approval-gate.git"
  },
  "keywords": ["mcp", "model-context-protocol", "human-in-the-loop", "agent-safety", "approval", "agent-skills"],
  "engines": { "node": ">=22" },
  "main": "src/gate.mjs",
  "exports": {
    ".": "./src/gate.mjs",
    "./effects": "./src/effects.mjs",
    "./server": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  }
}
